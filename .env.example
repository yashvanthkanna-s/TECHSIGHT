# ============================================================
# TechSight — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# NEVER commit .env to Git. It is already in .gitignore.
# ============================================================

# --- OpenAlex API ---
# Create a free account at https://openalex.org to get your key.
OPENALEX_API_KEY=ngJC5Xfw0QymVFnF7fQAvx
OPENALEX_EMAIL=manojk.it24@bitsathy.ac.in

# --- USPTO Open Data Portal (PatentsView) ---
# Register at https://account.uspto.gov, enable MFA,
# then get an API key from https://data.uspto.gov
USPTO_API_KEY=your_uspto_api_key_here

# --- EPO OPS (European Patent Office Open Patent Services) ---
# 100% Free worldwide patent database access (EP, US, WO, JP, etc.)
# 1. Register for free at https://developers.epo.org/
# 2. Go to 'My Apps' -> 'Add a new App'
# 3. Copy Consumer Key and Consumer Secret here:
EPO_CONSUMER_KEY=your_epo_consumer_key_here
EPO_CONSUMER_SECRET=your_epo_consumer_secret_here

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techsight
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# --- FastAPI Server ---
API_HOST=127.0.0.1
API_PORT=8000
